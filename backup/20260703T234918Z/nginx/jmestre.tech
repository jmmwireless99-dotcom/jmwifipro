# Alias domain for JM VPS (same panel as jmwifi.pro).
# Prefer the managed site: /etc/nginx/sites-available/jm-billing
# (see app/jm-billing/deploy/nginx-jm-billing.conf and add-domain-jmestre.sh).
#
# DNS required before TLS:
#   jmestre.tech     A   187.77.145.131
#   www.jmestre.tech A   187.77.145.131

server {
    listen 80;
    listen [::]:80;
    server_name jmestre.tech www.jmestre.tech;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
