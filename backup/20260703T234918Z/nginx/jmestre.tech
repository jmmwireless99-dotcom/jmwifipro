# jmestre.tech → VPS 112.209.31.253 (JEFF NETWORK SERVICE)
# DNS:
#   jmestre.tech     A   112.209.31.253
#   www.jmestre.tech A   112.209.31.253
#
# Live setup: app/jm-billing/deploy/add-domain-jmestre.sh

server {
    listen 80;
    listen [::]:80;
    server_name jmestre.tech www.jmestre.tech 112.209.31.253;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
